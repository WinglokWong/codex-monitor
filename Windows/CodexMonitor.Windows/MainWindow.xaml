<Window x:Class="CodexMonitor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Monitor" Width="344" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#E9EFF1" FontFamily="Segoe UI, Microsoft YaHei UI"
        ShowInTaskbar="True" Icon="Assets/AppIcon.ico" Topmost="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#98A4AA" />
    <SolidColorBrush x:Key="Mint" Color="#8AE8B5" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303A3E" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
      <Setter Property="Height" Value="4" /><Setter Property="Foreground" Value="{StaticResource Mint}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid x:Name="PART_Track" ClipToBounds="True">
          <Border Background="#2B3539" CornerRadius="3" />
          <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="11" /></Style>
  </Window.Resources>
  <Border Background="#171F23" CornerRadius="20" BorderBrush="#364146" BorderThickness="1" Padding="20,17,20,17">
    <StackPanel>
      <Grid MouseLeftButtonDown="DragHeader" Background="Transparent" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Image Source="Assets/AppIcon.png" Width="19" Height="19" />
        <TextBlock Grid.Column="1" Text="C O D E X  M O N I T O R" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="↻" FontSize="17" Click="RefreshClicked" IsEnabled="{Binding CanRefresh}" ToolTip="刷新账号与额度" />
        <Button Grid.Column="3" Content="•••" FontSize="11" Click="MenuClicked" ToolTip="面板菜单" />
      </Grid>
      <Border Background="#252E33" CornerRadius="9" Padding="10,8" Margin="0,0,0,16"
              ToolTip="额度来自本机 Codex CLI 的登录账号；邮箱仅脱敏显示。">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="◉" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
          <TextBlock x:Name="AccountText" Grid.Column="1" Text="{Binding AccountLabel}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
          <Border Grid.Column="2" Background="#30473D" CornerRadius="10" Padding="7,2" MaxWidth="100">
            <TextBlock Text="{Binding PlanLabel}" Foreground="{StaticResource Mint}" FontSize="10" TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>
      </Border>
      <Grid><TextBlock Text="本周剩余额度" FontSize="13" FontWeight="SemiBold" />
        <TextBlock Text="7 DAYS" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Visibility="{Binding DefaultBucketVisibility}" />
        <ComboBox HorizontalAlignment="Right" Width="115" FontSize="10" Visibility="{Binding BucketSelectorVisibility}"
                  ItemsSource="{Binding State.Reading.Windows}" DisplayMemberPath="Label" SelectedValuePath="Id"
                  SelectedValue="{Binding State.SelectedBucketId, Mode=TwoWay}" />
      </Grid>
      <Grid Margin="0,7,0,9">
        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RemainingText}" FontSize="46" FontWeight="SemiBold" /><TextBlock Text="%" FontSize="21" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="2,0,0,8" /></StackPanel>
        <TextBlock Text="{Binding SyncLabel}" FontSize="10" Foreground="{Binding SyncBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,10" />
      </Grid>
      <ProgressBar Value="{Binding RemainingValue, Mode=OneWay}" Foreground="{Binding QuotaBrush}" Height="5" />
      <Grid Margin="0,11,0,0"><TextBlock Text="{Binding ResetText}" FontSize="11" /><TextBlock Text="北京时间" Style="{StaticResource Caption}" HorizontalAlignment="Right" /></Grid>
      <TextBlock Text="{Binding CountdownText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
      <Border Height="1" Background="#303A3E" Margin="0,17" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel>
          <Grid Margin="0,0,0,7"><TextBlock Text="CPU" Style="{StaticResource Caption}" VerticalAlignment="Center" /><TextBlock Text="{Binding CpuText}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
          <ProgressBar Value="{Binding CpuValue, Mode=OneWay}" />
          <TextBlock Text="{Binding CpuScope}" Style="{StaticResource Caption}" FontSize="10" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" ToolTip="Windows 物理内存使用量：总量减可用量。">
          <Grid Margin="0,0,0,7"><TextBlock Text="内存" Style="{StaticResource Caption}" VerticalAlignment="Center" /><TextBlock Text="{Binding MemoryText}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
          <ProgressBar Value="{Binding MemoryValue, Mode=OneWay}" Foreground="#A1BDFF" />
          <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Caption}" FontSize="10" Margin="0,6,0,0" />
        </StackPanel>
      </Grid>
      <Grid Margin="0,18,0,0" ToolTip="{Binding NetworkTooltip}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="↓ 下载" Style="{StaticResource Caption}" /><TextBlock Text="{Binding DownloadText}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="↑ 上传" Style="{StaticResource Caption}" /><TextBlock Text="{Binding UploadText}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
      </Grid>
      <Border Height="1" Background="#303A3E" Margin="0,17,0,10" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="25" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{Binding SyncBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DetailText}" FontSize="10" Foreground="{StaticResource Muted}" Height="15" Margin="0,3,0,0" /></StackPanel>
        <Button Grid.Column="1" Content="ⓘ" Click="ErrorClicked" IsEnabled="{Binding HasFailure}" ToolTip="上次查询错误" VerticalAlignment="Top" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
